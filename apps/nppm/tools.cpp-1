// Get Home Folder
const char* get_home_dir()
{
    struct passwd *pw = getpwuid(getuid());
    return pw->pw_dir;
}

// Keyboard Input
void kbhit()
{
    struct termios argin, argout;
    unsigned char ch = 0;

    tcgetattr(0, &argin);
    argout = argin;
    argout.c_lflag &= ~(ICANON);
    argout.c_iflag &= ~(ICRNL);
    argout.c_oflag &= ~(OPOST);
    argout.c_cc[VMIN] = 1;
    argout.c_cc[VTIME] = 0;
    tcsetattr(0, TCSADRAIN, &argout);

    tcsetattr(0, TCSADRAIN, &argin);
}

int kbhit_2()
{
    struct timeval tv;
    fd_set read_fd;
    tv.tv_sec = 0;
    tv.tv_usec = 0;
    FD_ZERO(&read_fd);
    FD_SET(0, &read_fd);

    if (select(1, &read_fd, NULL, NULL, &tv) == -1)
        return 0;

    if (FD_ISSET(0, &read_fd))
        return 1;

    return 0;
}

// Utility Functions
std::string utl::now_as_string()
{
    time_t rawtime;
    struct tm *timeinfo;
    char buffer[80];
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    strftime(buffer, sizeof(buffer), "%d-%m-%Y[%H-%M-%S]", timeinfo);
    std::string str(buffer);
    std::cout << str;
    return str;
}

void utl::term::cin2empty()
{
    if (std::cin.fail())
    {
        std::cin.clear();
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    }
}

void utl::term::cin2buf_nshq_(char path[], int len)
{
    if (len < 1023)
    {
        std::cerr << "Buffer length: {" << len << "}, 256 required" << std::endl;
        exit(0);
    }

    int acnt = 0;
    do
    {
        const int TWENTY_ONE = 121;
        static char aDebug[TWENTY_ONE][256];
        utl::term::cin2empty();
        std::cin.getline(path, len);

        if (*path == EOF)
        {
            std::cerr << "An error occurs, or end-of-file is reached.";
        }

        strcpy(aDebug[acnt], path);
        utl::term::cin2empty();

        acnt++;
        if (acnt >= TWENTY_ONE)
        {
            std::cout << "cin2buf_nshq():: Comment lines too many!!" << std::endl;
            std::cout << "Match key is: {" << path << "}, Does c++ name it?" << std::endl;
            for (int i = 0; i < TWENTY_ONE; i++)
                std::cout << "[" << i + 1 << "]: " << aDebug[i] << std::endl;
            std::cout << std::endl
                      << "Good Manner Aborted!!" << std::endl
                      << std::endl;
            exit(0); //since the control script is not good
        }
    } while (
        path[0] == '#' ||
        path[0] == '\0' ||
        path[0] == '*' ||
        path[0] == '{' ||
        path[0] == '}' ||
        path[0] == '$' ||
        path[0] == ' ');
}

void simple_tokenizer(std::string double_values_string, double vle[])
{
    std::stringstream ss(double_values_string);
    double word;
    int aI = 0;
    while (ss >> word)
    {
        std::cout << word << " ";
        vle[aI++] = word;
    }
    std::cout << std::endl;
}

void align_token_dbls(double values[], bool debug)
{
    std::string string_token;
    get_string_q(string_token);
    simple_tokenizer(string_token, values);
}

std::string str_token(std::string &string_token)
{
    get_string_q(string_token);
    return string_token;
}

double align_token_str_dbl_(std::string &target, double &value)
{
    get_string_q(target);
    std::cin >> value;
    return value;
}

double align_token_str_dbl(std::string &namedValue, double &value, bool debug)
{
    align_token_str_dbl_(namedValue, value);
    if (debug)
    {
        std::cout << "#?? <double> named variable (double): {" << namedValue << " <- " << value << "}" << std::endl;
        std::cout << namedValue << std::endl
                  << value << std::endl
                  << "#!!!!" << std::endl;

        caster[namedValue]["type"] = "double";
        caster[namedValue]["value"] = value;
    }
    return value;
}

bool align_token_str_bool_(std::string &target, bool &true_or_false)
{
    get_string_q(target);
    std::cin >> true_or_false;
    return true_or_false;
}

bool align_token_str_bool(std::string &target, bool &true_or_false, bool debug)
{
    align_token_str_bool_(target, true_or_false);
    if (debug)
    {
        std::cout << "#?? <bool> named variable (   bool): {" << target << " <- " << true_or_false << "}" << std::endl;
        std::cout << target << std::endl
                  << true_or_false << std::endl;
        caster[target]["type"] = "bool";
        caster[target]["value"] = true_or_false;
    }
    return true_or_false;
}

int align_token_str_int_(std::string &target, int &a_int)
{
    get_string_q(target);
    std::cin >> a_int;
    return a_int;
}

int align_token_str_int(std::string &namedValue, int &a_int, bool debug)
{
    align_token_str_int_(namedValue, a_int);
    if (debug)
    {
        std::cout << "#?? <int> named variable (   int): {" << namedValue << " <- " << a_int << "}" << std::endl;
        caster[namedValue]["type"] = "int";
        caster[namedValue]["value"] = a_int;
    }
    return a_int;
}

std::string align_token_str_str_and_skip_comment(const std::string &target, std::string &a_string)
{
    std::string a_target;
    get_string_q(a_target);

    if (a_target != target)
    {
        std::cerr << "TARGET CAST:< " << target << " > BUT OBTAINED:< " << a_target << " >" << std::endl;
        exit(0);
    }
    assert(a_target == target);
    get_string_q(a_string);
    return a_string;
}

std::string align_token_str_str(const std::string &namedValue, std::string &a_string, bool debug)
{
    std::string cmp("@");
    if (namedValue.substr(0, 1) == cmp)
    {
        align_token_str_str_and_skip_comment(namedValue, a_string);
        if (debug)
        {
            std::cout << "#?? <string> Matched variable, (string): {" << std::endl
                      << namedValue << std::endl
                      << a_string << std::endl
                      << "#}" << std::endl
                      << "###" << std::endl;
        }
        caster[namedValue]["type"] = "string";
        caster[namedValue]["value"] = a_string;
    }
    else
    {
        std::cout << std::endl
                  << "*********************************************************" << std::endl;
        std::cout << "..Illegal non-@-headed string: {" << namedValue << "}" << std::endl;
        std::cout << "Mandatory to call this with head @" << std::endl;
        std::cout << "*********************************************************" << std::endl;
        exit(0);
    }
    return a_string;
}

